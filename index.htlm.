<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BAHIA CAFÉ - Gestion</title>
<style>
* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #f4f5f7;
  color: #252525;
}
header {
  background: #242424;
  color: white;
  padding: 20px;
}
header h1 { margin: 0; color: #e33b32; }
header p { margin: 5px 0 0; }
nav {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  padding: 15px;
  background: white;
}
nav button {
  border: 0;
  background: #333;
  color: white;
  padding: 12px 15px;
  border-radius: 6px;
  cursor: pointer;
}
nav button:hover { background: #e33b32; }
main { padding: 20px; max-width: 1100px; margin: auto; }
.panel {
  background: white;
  padding: 20px;
  border-radius: 10px;
  margin-bottom: 18px;
  box-shadow: 0 2px 8px #00000010;
}
h2 { margin-top: 0; }
input, select, textarea {
  display: block;
  width: 100%;
  padding: 11px;
  margin: 8px 0 14px;
  border: 1px solid #ccc;
  border-radius: 6px;
  font-size: 16px;
}
.action {
  background: #e33b32;
  color: white;
  border: 0;
  padding: 12px 18px;
  border-radius: 6px;
  cursor: pointer;
}
table { width: 100%; border-collapse: collapse; }
th, td {
  padding: 10px;
  border-bottom: 1px solid #ddd;
  text-align: left;
}
.hidden { display: none; }
@media(max-width:600px) {
  main { padding: 12px; }
  nav button { flex: 1 1 45%; }
}
</style>
</head>
<body>

<header>
  <h1>BAHIA CAFÉ</h1>
  <p>Gestion du stock, des machines et des réparations</p>
</header>

<nav>
  <button onclick="showPage('accueil')">Accueil</button>
  <button onclick="showPage('pieces')">Pièces détachées</button>
  <button onclick="showPage('machines')">Machines</button>
  <button onclick="showPage('reparations')">Réparations</button>
  <button onclick="showPage('clients')">Clients</button>
  <button onclick="showPage('factures')">Factures</button>
  <button onclick="showPage('fournisseurs')">Fournisseurs</button>
  <button onclick="showPage('rapports')">Rapports</button>
</nav>

<main>
  <section id="accueil" class="page">
    <div class="panel">
      <h2>Tableau de bord</h2>
      <p>Bienvenue dans votre espace de gestion BAHIA CAFÉ.</p>
      <p>Adresse : ch. de l'Esparcette 5, 1023 Crissier</p>
      <p>Devise : CHF</p>
    </div>
  </section>

  <section id="pieces" class="page hidden">
    <div class="panel">
      <h2>Pièces détachées</h2>
      <form id="stockForm">
        <label>Nom de la pièce</label>
        <input id="partName" required>
        <label>Référence</label>
        <input id="partRef">
        <label>Marque</label>
        <select id="partBrand">
          <option>Dr Coffee</option>
          <option>Sanremo</option>
          <option>Astoria</option>
          <option>Siemens</option>
          <option>Ceado</option>
          <option>Santos</option>
          <option>Autre</option>
        </select>
        <label>Quantité</label>
        <input id="partQty" type="number" min="0" required>
        <label>Stock minimum</label>
        <input id="partMin" type="number" min="0" value="1">
        <label>Prix unitaire (CHF)</label>
        <input id="partPrice" type="number" min="0" step="0.01">
        <button class="action" type="submit">Ajouter la pièce</button>
      </form>
    </div>
    <div class="panel">
      <h2>Liste du stock</h2>
      <div style="overflow-x:auto">
        <table>
          <thead><tr><th>Pièce</th><th>Référence</th><th>Marque</th><th>Quantité</th><th>Prix CHF</th></tr></thead>
          <tbody id="stockList"></tbody>
        </table>
      </div>
    </div>
  </section>

  <section id="machines" class="page hidden">
    <div class="panel">
      <h2>Machines</h2>
      <p>Gestion des machines à café et moulins.</p>
      <p>Marques : Dr Coffee, Sanremo, Astoria, Siemens, Ceado et Santos.</p>
    </div>
  </section>

  <section id="reparations" class="page hidden">
    <div class="panel">
      <h2>Réparations</h2>
      <p>Suivi des réparations et interventions techniques.</p>
    </div>
  </section>

  <section id="clients" class="page hidden">
    <div class="panel">
      <h2>Clients</h2>
      <p>Fichier clients de BAHIA CAFÉ.</p>
    </div>
  </section>

  <section id="factures" class="page hidden">
    <div class="panel">
      <h2>Factures</h2>
      <p>Création et suivi des factures en CHF.</p>
    </div>
  </section>

  <section id="fournisseurs" class="page hidden">
    <div class="panel">
      <h2>Fournisseurs</h2>
      <p>Gestion des fournisseurs et commandes.</p>
    </div>
  </section>

  <section id="rapports" class="page hidden">
    <div class="panel">
      <h2>Rapports</h2>
      <p>Rapports de stock et d'activité.</p>
    </div>
  </section>
</main>

<script>
function showPage(page) {
  document.querySelectorAll('.page').forEach(section => {
    section.classList.add('hidden');
  });
  document.getElementById(page).classList.remove('hidden');
}

let stock = [];

document.getElementById('stockForm').addEventListener('submit', function(event) {
  event.preventDefault();

  const part = {
    name: document.getElementById('partName').value,
    ref: document.getElementById('partRef').value,
    brand: document.getElementById('partBrand').value,
    qty: Number(document.getElementById('partQty').value),
    min: Number(document.getElementById('partMin').value),
    price: Number(document.getElementById('partPrice').value || 0)
  };

  stock.push(part);
  renderStock();
  this.reset();
});

function renderStock() {
  const list = document.getElementById('stockList');
  list.innerHTML = '';

  stock.forEach(part => {
    const row = document.createElement('tr');
    [part.name, part.ref, part.brand, part.qty, part.price.toFixed(2)]
      .forEach(value => {
        const cell = document.createElement('td');
        cell.textContent = value;
        row.appendChild(cell);
      });
    list.appendChild(row);
  });
}
</script>

</body>
</html>

